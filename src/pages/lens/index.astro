---
import { defaultLensSettings, lensControlGroups } from '@/components/lens/lens-config'

const pageTitle = 'Square Lens — 筷筷实验室'
const pageDescription = '一个由 Three.js 与 GLSL 驱动、跟随指针移动的方形透镜实验。'
const imageUrl = '/images/lens-heliconia.png'
---

<!doctype html>
<html lang="zh-cn">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#090a09" />
		<meta name="description" content={pageDescription} />
		<title>{pageTitle}</title>
		<link rel="preload" href={imageUrl} as="image" fetchpriority="high" />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%221em%22 font-size=%2280%22>◩</text></svg>"
		/>
	</head>
	<body>
		<main class="experience" data-lens-page data-image-url={imageUrl}>
			<div class="fallback" aria-hidden="true">
				<img src={imageUrl} alt="" fetchpriority="high" />
			</div>
			<canvas class="lens-canvas" data-lens-canvas aria-hidden="true"></canvas>

			<header class="topbar">
				<a class="wordmark" href="/" aria-label="返回博客首页">
					<span class="wordmark-mark">KK</span>
					<span>筷筷实验室</span>
				</a>
				<span class="edition">WEBGL / 01</span>
			</header>

			<section class="intro" aria-labelledby="lens-title">
				<p class="eyebrow">CHROMATIC FIELD STUDY</p>
				<h1 id="lens-title"><span>SQUARE</span><span>LENS</span></h1>
				<p class="intro-copy">移动指针，让色彩穿过灰阶表面。</p>
			</section>

			<div class="pointer-hint" aria-hidden="true">
				<span class="pointer-dot"></span>
				<span>移动指针</span>
			</div>

			<details class="control-deck">
				<summary>
					<span>调节效果</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M6 14v6"></path>
					</svg>
				</summary>
				<div class="control-panel">
					{
						lensControlGroups.map((group) => (
							<fieldset>
								<legend>{group.label}</legend>
								{group.controls.map((control) => (
									<label>
										<span>{control.label}</span>
										<input
											data-setting={control.setting}
											type="range"
											min={control.min}
											max={control.max}
											step={control.step}
											value={defaultLensSettings[control.setting]}
										/>
									</label>
								))}
							</fieldset>
						))
					}
				</div>
			</details>

			<footer class="credits">
				<span>THREE.JS + GLSL</span>
				<a
					href="https://tympanus.net/codrops/2026/08/25/building-a-mouse-following-square-lens-effect-with-three-js-and-glsl/"
					target="_blank"
					rel="noreferrer"
				>
					灵感来源 Codrops ↗
				</a>
			</footer>
		</main>

		<script>
			import { createLensEffect, type LensEffect } from '@/components/lens/LensEffect'
			import type { LensSettings } from '@/components/lens/lens-config'

			const page = document.querySelector<HTMLElement>('[data-lens-page]')
			const canvas = document.querySelector<HTMLCanvasElement>('[data-lens-canvas]')
			let lensEffect: LensEffect | undefined

			const boot = async () => {
				if (!page || !canvas || !page.dataset.imageUrl) return

				try {
					lensEffect = await createLensEffect(canvas, page.dataset.imageUrl)
					page.dataset.ready = 'true'

					document.querySelectorAll<HTMLInputElement>('[data-setting]').forEach((input) => {
						input.addEventListener('input', () => {
							const setting = input.dataset.setting as keyof LensSettings
							lensEffect?.update({ [setting]: Number(input.value) })
						})
					})
				} catch (error) {
					console.error('无法启动方形透镜效果。', error)
					page.dataset.error = 'true'
				}
			}

			boot()

			document.addEventListener('astro:before-swap', () => lensEffect?.dispose(), { once: true })
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #090a09;
		font-family: Inter, 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
		color: #f4f1e8;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100svh;
		overflow: hidden;
	}

	:global(a) {
		color: inherit;
	}

	.experience {
		position: fixed;
		inset: 0;
		isolation: isolate;
		background: #090a09;
	}

	.experience::after {
		position: absolute;
		z-index: 2;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				rgb(0 0 0 / 34%) 0%,
				transparent 30%,
				transparent 68%,
				rgb(0 0 0 / 38%) 100%
			),
			radial-gradient(circle at 50% 50%, transparent 40%, rgb(0 0 0 / 26%) 100%);
		content: '';
		pointer-events: none;
	}

	.fallback,
	.lens-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.fallback img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) brightness(0.72) contrast(1.12);
	}

	.lens-canvas {
		z-index: 1;
		display: block;
		opacity: 0;
		transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}

	.experience[data-ready='true'] .lens-canvas {
		opacity: 1;
	}

	.topbar,
	.intro,
	.pointer-hint,
	.control-deck,
	.credits {
		position: absolute;
		z-index: 3;
	}

	.topbar {
		top: 0;
		left: 0;
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		padding: clamp(20px, 3vw, 42px);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		text-decoration: none;
	}

	.wordmark-mark {
		display: grid;
		width: 32px;
		height: 32px;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 48%);
		font-size: 9px;
		letter-spacing: 0.04em;
		transition: 180ms ease;
	}

	.wordmark:hover .wordmark-mark {
		background: #f4f1e8;
		color: #10110f;
	}

	.edition {
		margin-right: 124px;
		opacity: 0.58;
	}

	.intro {
		bottom: clamp(74px, 10vh, 124px);
		left: clamp(20px, 5.5vw, 86px);
		pointer-events: none;
	}

	.eyebrow {
		margin: 0 0 15px;
		font-size: clamp(9px, 0.72vw, 11px);
		font-weight: 700;
		letter-spacing: 0.28em;
		opacity: 0.62;
	}

	h1 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(64px, 10.5vw, 166px);
		font-weight: 400;
		letter-spacing: -0.075em;
		line-height: 0.72;
	}

	h1 span {
		display: block;
	}

	h1 span:last-child {
		margin-left: 0.58em;
		font-style: italic;
	}

	.intro-copy {
		margin: 24px 0 0 0.15em;
		font-size: 12px;
		letter-spacing: 0.14em;
		opacity: 0.72;
	}

	.pointer-hint {
		right: clamp(24px, 6vw, 96px);
		bottom: 88px;
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		transition: opacity 250ms ease;
		pointer-events: none;
	}

	.pointer-dot {
		width: 7px;
		height: 7px;
		border: 1px solid currentColor;
		border-radius: 50%;
		animation: breathe 1.8s ease-in-out infinite;
	}

	.control-deck {
		top: clamp(20px, 3vw, 42px);
		right: clamp(20px, 3vw, 42px);
		width: 210px;
		font-size: 11px;
	}

	.control-deck summary {
		display: flex;
		width: 104px;
		height: 34px;
		margin-left: auto;
		align-items: center;
		justify-content: center;
		gap: 8px;
		border: 1px solid rgb(255 255 255 / 32%);
		background: rgb(13 14 12 / 36%);
		font-weight: 700;
		letter-spacing: 0.12em;
		list-style: none;
		cursor: pointer;
		backdrop-filter: blur(12px);
	}

	.control-deck summary::-webkit-details-marker {
		display: none;
	}

	.control-deck summary svg {
		width: 15px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-width: 1.5;
	}

	.control-panel {
		display: grid;
		margin-top: 8px;
		padding: 16px;
		max-height: calc(100svh - 94px);
		gap: 18px;
		border: 1px solid rgb(255 255 255 / 24%);
		background: rgb(9 10 9 / 72%);
		box-shadow: 0 22px 50px rgb(0 0 0 / 24%);
		overflow-y: auto;
		backdrop-filter: blur(20px);
		scrollbar-width: thin;
	}

	.control-panel fieldset {
		display: grid;
		margin: 0;
		padding: 0;
		gap: 12px;
		border: 0;
	}

	.control-panel legend {
		margin-bottom: 12px;
		padding: 0;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.18em;
		opacity: 0.52;
	}

	.control-panel label {
		display: grid;
		gap: 6px;
		letter-spacing: 0.08em;
	}

	.control-panel input {
		width: 100%;
		height: 2px;
		margin: 5px 0;
		appearance: none;
		border-radius: 0;
		background: rgb(255 255 255 / 36%);
		accent-color: #f05c2a;
	}

	.control-panel input::-webkit-slider-thumb {
		width: 11px;
		height: 11px;
		appearance: none;
		border: 0;
		border-radius: 50%;
		background: #f4f1e8;
		cursor: grab;
	}

	.credits {
		right: clamp(20px, 3vw, 42px);
		bottom: clamp(18px, 3vw, 34px);
		left: clamp(20px, 3vw, 42px);
		display: flex;
		justify-content: space-between;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.credits a {
		text-decoration: none;
		opacity: 0.66;
		transition: opacity 180ms ease;
	}

	.credits a:hover {
		opacity: 1;
	}

	@keyframes breathe {
		50% {
			transform: scale(1.7);
			opacity: 0.38;
		}
	}

	@media (max-width: 700px) {
		.edition,
		.pointer-hint {
			display: none;
		}

		.intro {
			bottom: 84px;
		}

		h1 {
			font-size: clamp(58px, 22vw, 104px);
			line-height: 0.77;
		}

		h1 span:last-child {
			margin-left: 0.2em;
		}

		.intro-copy {
			max-width: 220px;
			font-size: 10px;
			line-height: 1.7;
		}

		.control-deck {
			width: min(210px, calc(100vw - 40px));
		}

		.credits span {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lens-canvas,
		.wordmark-mark,
		.credits a {
			transition: none;
		}

		.pointer-dot {
			animation: none;
		}
	}
</style>
